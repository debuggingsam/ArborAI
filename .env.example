# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arborai

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# WebSocket
WS_PATH=/ws

# AI provider (mock mode is offline and does not require credentials)
AI_PROVIDER=mock
ANSWER_MODEL=
TREE_MAKER_MODEL=
CAPSULE_MODEL=
OPENAI_API_KEY=

TREE_MAKER_HIGH_CONFIDENCE=0.85
TREE_MAKER_LOW_CONFIDENCE=0.55
MAX_INPUT_TOKENS=
TREE_MAKER_MAX_TOPICS=
TREE_MAKER_RECENT_MESSAGES_PER_TOPIC=3

MOCK_STREAM_DELAY_MS=40
MOCK_FORCE_FAILURE=false
MOCK_MALFORMED_STRUCTURED_OUTPUT=false
MOCK_INTERRUPT_STREAM=false
