generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NodeRole {
  system
  user
  assistant
}

enum NodeStatus {
  pending
  streaming
  completed
  error
}

model Conversation {
  id           String             @id @default(uuid()) @db.Uuid
  title        String
  systemPrompt String?
  activeNodeId String?            @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  nodes        ConversationNode[]

  @@index([updatedAt])
}

model ConversationNode {
  id             String             @id @default(uuid()) @db.Uuid
  conversationId String             @db.Uuid
  parentId       String?            @db.Uuid
  role           NodeRole
  content        String
  status         NodeStatus
  tokenCount     Int?
  errorMessage   String?
  prunedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent         ConversationNode?  @relation("NodeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       ConversationNode[] @relation("NodeTree")

  @@index([conversationId])
  @@index([parentId])
  @@index([conversationId, createdAt])
}
